<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.supercell.brawlstars" />
        <package android:name="com.ea.gp.fifamobile" />
        <package android:name="com.fungames.blockcraft" />
        <package android:name="com.robtopx.geometryjumplite" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="AGNES FAMILY"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
